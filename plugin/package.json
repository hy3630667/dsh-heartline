{
  "name": "dsh-heartline",
  "version": "0.2.2",
  "description": "心跳急救：三份心跳（外部本体 / DSH 宿主 / 网页）互证，设置页能看能调。插件只当证人，不杀不拉。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "watchdog",
    "heartbeat"
  ]
}